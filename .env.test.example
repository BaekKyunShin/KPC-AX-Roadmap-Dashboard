# .env.test.example
# E2E 테스트 환경 변수 — 로컬 Supabase (supabase start) 사용
# .env.test로 복사 후 테스트 계정 정보를 입력하세요

# ─── 로컬 Supabase (supabase start 기본값) ──────────────────
# 이 키들은 모든 로컬 Supabase 인스턴스에서 동일한 공개 기본값입니다
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# ─── LLM (앱 기동에 필요하지만 E2E에서 실제 호출 없음 — 아무 문자열이나 입력) ─
LLM_API_KEY=

# ─── 테스트 계정 (seed.sql에서 생성됨 — 비밀번호는 seed.sql 참조) ─
E2E_OPS_ADMIN_EMAIL=
E2E_OPS_ADMIN_PASSWORD=
E2E_CONSULTANT_EMAIL=
E2E_CONSULTANT_PASSWORD=
# SYSTEM_ADMIN (선택 — 미설정 시 관련 E2E 테스트 자동 skip)
E2E_SYSTEM_ADMIN_EMAIL=
E2E_SYSTEM_ADMIN_PASSWORD=
