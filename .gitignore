# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
.auth/
playwright-report/
test-results/
supabase/.temp/
supabase/.branches/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.serena/
.worktrees/
.mcp.json

# reference files
/_reference

# internal docs (account migration)
docs/plans/archive/2026-02-19-company-account-migration.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.test.example

# vercel
.vercel
.vercel.pre-transfer-*

# account migration backups (local only, never commit)
.secrets-backup-*.txt
backup-*.sql

# typescript
*.tsbuildinfo
next-env.d.ts

# tool artifacts
.playwright-mcp/
.superpowers/
# Claude Code scheduled task 일시 락 파일 — 런타임에 자동 생성됨
.claude/scheduled_tasks.lock
# Claude Code 권한·설정 파일 — 로컬·팀 모두 개별 관리
.claude/settings.json

# 임시 작업용 Nielsen 휴리스틱 감사 보고서 (재실행 시마다 갱신)
docs/reports/2026-05-02-nielsen-heuristics-audit.md
# Playwright MCP 검증 시 생성되는 스크린샷
pbl-*.png
roadmap-*.png
# 단, docs/screenshots/ 하위는 UI 통일성 검증 증거물로 추적
!docs/screenshots/**/pbl-*.png
!docs/screenshots/**/roadmap-*.png

# Python (HWPX 관련 로컬 도구)
.venv/
.venv-hwpx/
__pycache__/
*.pyc
*.pyo
