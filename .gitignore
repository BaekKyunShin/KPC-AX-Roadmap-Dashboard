# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
.auth/
playwright-report/
test-results/
supabase/.temp/
supabase/.branches/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.serena/
.worktrees/
.mcp.json

# reference files
/_reference

# internal docs (account migration)
docs/2026-02-19-company-account-migration.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.test.example

# vercel
.vercel
.vercel.pre-transfer-*

# account migration backups (local only, never commit)
.secrets-backup-*.txt
backup-*.sql

# typescript
*.tsbuildinfo
next-env.d.ts

# tool artifacts
.playwright-mcp/
.superpowers/
# Playwright MCP 검증 시 생성되는 스크린샷
pbl-*.png
roadmap-*.png

# Python (HWPX 관련 로컬 도구)
.venv/
.venv-hwpx/
__pycache__/
*.pyc
*.pyo
